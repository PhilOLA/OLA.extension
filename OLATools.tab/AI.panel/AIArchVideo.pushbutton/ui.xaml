<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Title="AI Arch Video" Height="1020" Width="660"
        Background="#FFEEEEF2">

    <Window.Resources>
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#FF8A8A94"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="RoundedTextBox" TargetType="TextBox">
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="BorderBrush" Value="#FFDCDCE3"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RoundedComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="BorderBrush" Value="#FFDCDCE3"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton" Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                BorderThickness="1" CornerRadius="6"/>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            <TextBlock Text="&#9662;" HorizontalAlignment="Right" VerticalAlignment="Center"
                                       Margin="0,0,10,0" Foreground="#FF8A8A94" IsHitTestVisible="False"/>
                            <Popup x:Name="Popup" Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Border Background="White" BorderBrush="#FFDCDCE3" BorderThickness="1"
                                        CornerRadius="6" MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="220" Margin="0,4,0,0">
                                    <ScrollViewer><ItemsPresenter/></ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ComboItemTooltip" TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, Path=Content}"/>
        </Style>

        <!-- Collapsible section header button -->
        <Style x:Key="CollapseHeader" TargetType="Button">
            <Setter Property="Background" Value="#FFF0F0F5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FFE4E4EC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Border Margin="14" Background="White" CornerRadius="10" Padding="20">
            <Border.Effect>
                <DropShadowEffect Color="#FF000000" BlurRadius="20" ShadowDepth="3" Opacity="0.12"/>
            </Border.Effect>

            <Grid>
                <!-- ===================== SETTINGS PANEL ===================== -->
                <ScrollViewer x:Name="settings_panel" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="AI Arch Video" FontSize="21" FontWeight="Bold"
                                   Foreground="#FF222228" Margin="0,0,0,4"/>
                        <TextBlock Foreground="#FF8A8A94" Margin="0,0,0,16" TextWrapping="Wrap"
                                   FontSize="12.5">
                            Select views, set interior/exterior type, configure render settings.
                        </TextBlock>

                        <!-- 3D Views list -->
                        <TextBlock Text="3D VIEWS" Style="{StaticResource SectionLabel}"/>
                        <TextBlock Text="Tick to select views. Click the EXT/INT badge to toggle view type. Use &#9650;&#9660; to set clip order."
                                   FontSize="11" Foreground="#FFB0B0B8" Margin="0,0,0,6" TextWrapping="Wrap"/>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" BorderBrush="#FFDCDCE3" BorderThickness="1"
                                    CornerRadius="6" Background="White" Height="160" ClipToBounds="True">
                                <ListBox x:Name="view_list" SelectionMode="Single"
                                         BorderThickness="0" Background="Transparent"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         FontSize="12.5" Padding="4"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="6,0,0,0" VerticalAlignment="Center">
                                <Button x:Name="move_up_btn" Content="&#9650;" Width="28" Height="28"
                                        Margin="0,0,0,4" Click="move_up_click"
                                        Background="#FFEDEDF1" Foreground="#FF444450"/>
                                <Button x:Name="move_down_btn" Content="&#9660;" Width="28" Height="28"
                                        Click="move_down_click"
                                        Background="#FFEDEDF1" Foreground="#FF444450"/>
                            </StackPanel>
                        </Grid>

                        <!-- Multi-clip options -->
                        <StackPanel x:Name="multiclip_panel" Visibility="Collapsed" Margin="0,8,0,0">
                            <TextBlock Text="MULTIPLE VIEWS SELECTED" Style="{StaticResource SectionLabel}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,6">
                                <RadioButton x:Name="rb_separate" Content="Keep as separate clips"
                                             IsChecked="True" Margin="0,0,16,0" FontSize="12.5"
                                             Checked="output_mode_changed"/>
                                <RadioButton x:Name="rb_stitch" Content="Stitch into one video"
                                             FontSize="12.5" Checked="output_mode_changed"/>
                            </StackPanel>
                            <StackPanel x:Name="transition_panel" Orientation="Horizontal"
                                        Visibility="Collapsed">
                                <TextBlock Text="Transition:" VerticalAlignment="Center"
                                           FontSize="12" Foreground="#FF8A8A94" Margin="0,0,8,0"/>
                                <RadioButton x:Name="rb_cut" Content="Hard cut" IsChecked="True"
                                             Margin="0,0,14,0" FontSize="12.5"/>
                                <RadioButton x:Name="rb_crossfade" Content="Crossfade (0.5s)" FontSize="12.5"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- ── EXTERIOR SETTINGS ── collapsible -->
                        <Button x:Name="ext_header_btn" Style="{StaticResource CollapseHeader}"
                                Margin="0,14,0,0" Click="toggle_ext_click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="ext_arrow" Text="&#9660;" FontSize="11"
                                           Foreground="#FF2F6FED" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <Border Background="#FF2F6FED" CornerRadius="4" Padding="5,2" Margin="0,0,8,0">
                                    <TextBlock Text="EXT" FontSize="10" FontWeight="Bold" Foreground="White"/>
                                </Border>
                                <TextBlock Text="Exterior Settings" FontSize="13" FontWeight="SemiBold"
                                           Foreground="#FF222228" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <StackPanel x:Name="ext_body" Margin="0,8,0,0">
                            <TextBlock Text="STYLE" Style="{StaticResource SectionLabel}"/>
                            <ComboBox x:Name="ext_style_combo" Style="{StaticResource RoundedComboBox}"
                                      ItemContainerStyle="{StaticResource ComboItemTooltip}" Margin="0,0,0,12"/>
                            <TextBlock Text="RECENT EXTRA DIRECTION" Style="{StaticResource SectionLabel}"/>
                            <ComboBox x:Name="ext_recent_extra_combo" Style="{StaticResource RoundedComboBox}"
                                      ItemContainerStyle="{StaticResource ComboItemTooltip}" Margin="0,0,0,8"
                                      SelectionChanged="ext_recent_extra_changed"/>
                            <TextBlock Text="EXTRA DIRECTION (MATERIALS, MOOD, CONTEXT)"
                                       Style="{StaticResource SectionLabel}" Margin="0,0,0,2"/>
                            <TextBox x:Name="ext_extra_box" Style="{StaticResource RoundedTextBox}"
                                     Height="210" AcceptsReturn="True" TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto" Margin="0,0,0,10"/>
                            <TextBlock Text="RECENT MOTION PROMPTS" Style="{StaticResource SectionLabel}"/>
                            <ComboBox x:Name="ext_recent_motion_combo" Style="{StaticResource RoundedComboBox}"
                                      ItemContainerStyle="{StaticResource ComboItemTooltip}" Margin="0,0,0,8"
                                      SelectionChanged="ext_recent_motion_changed"/>
                            <TextBlock Text="MOTION / CAMERA DIRECTION"
                                       Style="{StaticResource SectionLabel}" Margin="0,0,0,2"/>
                            <TextBox x:Name="ext_motion_box" Style="{StaticResource RoundedTextBox}"
                                     Height="210" AcceptsReturn="True" TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto" Margin="0,0,0,10"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="IMAGE QUALITY" Style="{StaticResource SectionLabel}"
                                           Margin="0,0,0,0" VerticalAlignment="Center" Width="200"/>
                                <TextBlock Text="VIDEO QUALITY &amp; DURATION" Style="{StaticResource SectionLabel}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <ComboBox x:Name="ext_image_quality_combo" Style="{StaticResource RoundedComboBox}"
                                          Width="190" Margin="0,0,8,0"
                                          ItemContainerStyle="{StaticResource ComboItemTooltip}"/>
                                <ComboBox x:Name="ext_video_quality_combo" Style="{StaticResource RoundedComboBox}"
                                          ItemContainerStyle="{StaticResource ComboItemTooltip}"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- ── INTERIOR SETTINGS ── collapsible -->
                        <Button x:Name="int_header_btn" Style="{StaticResource CollapseHeader}"
                                Margin="0,14,0,0" Click="toggle_int_click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="int_arrow" Text="&#9660;" FontSize="11"
                                           Foreground="#FF27AE60" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <Border Background="#FF27AE60" CornerRadius="4" Padding="5,2" Margin="0,0,8,0">
                                    <TextBlock Text="INT" FontSize="10" FontWeight="Bold" Foreground="White"/>
                                </Border>
                                <TextBlock Text="Interior Settings" FontSize="13" FontWeight="SemiBold"
                                           Foreground="#FF222228" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <StackPanel x:Name="int_body" Margin="0,8,0,0">
                            <TextBlock Text="STYLE" Style="{StaticResource SectionLabel}"/>
                            <ComboBox x:Name="int_style_combo" Style="{StaticResource RoundedComboBox}"
                                      ItemContainerStyle="{StaticResource ComboItemTooltip}" Margin="0,0,0,12"/>
                            <TextBlock Text="RECENT EXTRA DIRECTION" Style="{StaticResource SectionLabel}"/>
                            <ComboBox x:Name="int_recent_extra_combo" Style="{StaticResource RoundedComboBox}"
                                      ItemContainerStyle="{StaticResource ComboItemTooltip}" Margin="0,0,0,8"
                                      SelectionChanged="int_recent_extra_changed"/>
                            <TextBlock Text="EXTRA DIRECTION (MATERIALS, MOOD, CONTEXT)"
                                       Style="{StaticResource SectionLabel}" Margin="0,0,0,2"/>
                            <TextBox x:Name="int_extra_box" Style="{StaticResource RoundedTextBox}"
                                     Height="210" AcceptsReturn="True" TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto" Margin="0,0,0,10"/>
                            <TextBlock Text="RECENT MOTION PROMPTS" Style="{StaticResource SectionLabel}"/>
                            <ComboBox x:Name="int_recent_motion_combo" Style="{StaticResource RoundedComboBox}"
                                      ItemContainerStyle="{StaticResource ComboItemTooltip}" Margin="0,0,0,8"
                                      SelectionChanged="int_recent_motion_changed"/>
                            <TextBlock Text="MOTION / CAMERA DIRECTION"
                                       Style="{StaticResource SectionLabel}" Margin="0,0,0,2"/>
                            <TextBox x:Name="int_motion_box" Style="{StaticResource RoundedTextBox}"
                                     Height="210" AcceptsReturn="True" TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto" Margin="0,0,0,10"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="IMAGE QUALITY" Style="{StaticResource SectionLabel}"
                                           Margin="0,0,0,0" VerticalAlignment="Center" Width="200"/>
                                <TextBlock Text="VIDEO QUALITY &amp; DURATION" Style="{StaticResource SectionLabel}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <ComboBox x:Name="int_image_quality_combo" Style="{StaticResource RoundedComboBox}"
                                          Width="190" Margin="0,0,8,0"
                                          ItemContainerStyle="{StaticResource ComboItemTooltip}"/>
                                <ComboBox x:Name="int_video_quality_combo" Style="{StaticResource RoundedComboBox}"
                                          ItemContainerStyle="{StaticResource ComboItemTooltip}"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Buttons -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,4">
                            <Button x:Name="cancel_btn" Content="Cancel" Width="92" Height="32"
                                    Margin="0,0,8,0" Click="cancel_click"
                                    Background="#FFEDEDF1" Foreground="#FF444450"/>
                            <Button x:Name="render_btn" Content="Generate" Width="110" Height="32"
                                    Click="render_click" Background="#FF2F6FED" Foreground="White"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- ===================== PROGRESS PANEL ===================== -->
                <Grid x:Name="progress_panel" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" VerticalAlignment="Center">
                        <TextBlock Text="AI Arch Video" FontSize="21" FontWeight="Bold" Foreground="#FF222228"
                                   HorizontalAlignment="Center" Margin="0,0,0,20"/>
                        <TextBlock x:Name="progress_status_text" Text="Working..." FontSize="13.5"
                                   Foreground="#FF44444E" TextWrapping="Wrap" TextAlignment="Center"
                                   Margin="0,0,0,16"/>
                        <ProgressBar IsIndeterminate="True" Height="6" Margin="0,0,0,20"/>

                        <!-- Still render thumbnails - one added per view as generated -->
                        <ScrollViewer x:Name="thumbnail_scroll" Visibility="Collapsed"
                                      MaxHeight="300" Margin="20,0,20,16"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="thumbnail_stack"/>
                        </ScrollViewer>

                        <Button x:Name="progress_cancel_btn" Content="Close" Width="90" Height="32"
                                HorizontalAlignment="Center" Click="cancel_click"
                                Background="#FFEDEDF1" Foreground="#FF444450"/>
                    </StackPanel>

                    <Image x:Name="logo_image" Grid.Row="1" Height="170" Stretch="Uniform"
                           HorizontalAlignment="Center" VerticalAlignment="Bottom"
                           Margin="0,0,0,16" Opacity="0.85"/>
                </Grid>

                <!-- ===================== PREVIEW PANEL ===================== -->
                <Grid x:Name="preview_panel" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="AI Arch Video" FontSize="21" FontWeight="Bold"
                               Foreground="#FF222228" Margin="0,0,0,10"/>

                    <Border Grid.Row="1" Background="Black" CornerRadius="6" ClipToBounds="True">
                        <MediaElement x:Name="video_player" LoadedBehavior="Manual"
                                      UnloadedBehavior="Stop" Stretch="Uniform"
                                      MediaEnded="video_ended" MediaFailed="video_failed"/>
                    </Border>

                    <TextBlock Grid.Row="2" x:Name="preview_status_text" Text=""
                               Foreground="#FF8A8A94" FontSize="11" TextWrapping="Wrap"
                               Margin="0,8,0,8"/>

                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="open_folder_btn" Content="Open Folder" Width="100" Height="32"
                                Margin="0,0,6,0" Click="open_folder_click"
                                Background="#FFEDEDF1" Foreground="#FF444450"/>
                        <Button x:Name="new_render_btn" Content="New Render" Width="100" Height="32"
                                Margin="0,0,6,0" Click="new_render_click"
                                Background="#FFEDEDF1" Foreground="#FF444450"/>
                        <Button x:Name="close_btn" Content="Close" Width="90" Height="32"
                                Click="close_click" Background="#FF2F6FED" Foreground="White"/>
                    </StackPanel>
                </Grid>

            </Grid>
        </Border>
    </Grid>
</Window>
