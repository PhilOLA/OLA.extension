<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Title="AI Render" Height="740" Width="600"
        Background="#FFEEEEF2">

    <Window.Resources>
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#FF8A8A94"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <Style x:Key="RoundedTextBox" TargetType="TextBox">
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="BorderBrush" Value="#FFDCDCE3"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RoundedComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="BorderBrush" Value="#FFDCDCE3"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton" Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                BorderThickness="1"
                                                CornerRadius="6"/>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            <TextBlock Text="&#9662;" HorizontalAlignment="Right" VerticalAlignment="Center"
                                       Margin="0,0,10,0" Foreground="#FF8A8A94" IsHitTestVisible="False"/>
                            <Popup x:Name="Popup" Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Border Background="White" BorderBrush="#FFDCDCE3" BorderThickness="1"
                                        CornerRadius="6" MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="220" Margin="0,4,0,0">
                                    <ScrollViewer>
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ComboItemTooltip" TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, Path=Content}"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Border Margin="14" Background="White" CornerRadius="10" Padding="22">
            <Border.Effect>
                <DropShadowEffect Color="#FF000000" BlurRadius="20" ShadowDepth="3" Opacity="0.12"/>
            </Border.Effect>

            <!-- Three panels occupy the same space; only one is visible at a time. -->
            <Grid>

                <!-- ===================== SETTINGS PANEL ===================== -->
                <Grid x:Name="settings_panel">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="AI Render" FontSize="21" FontWeight="Bold" Foreground="#FF222228"/>
                    <TextBlock Grid.Row="1" Text="Describe how the active 3D view should be rendered."
                               Foreground="#FF8A8A94" Margin="0,4,0,18" TextWrapping="Wrap" FontSize="12.5"/>

                    <TextBlock Grid.Row="2" Text="STYLE" Style="{StaticResource SectionLabel}"/>
                    <ComboBox Grid.Row="3" x:Name="style_combo" Style="{StaticResource RoundedComboBox}"
                              ItemContainerStyle="{StaticResource ComboItemTooltip}" Margin="0,0,0,16"/>

                    <TextBlock Grid.Row="4" Text="RENDER QUALITY" Style="{StaticResource SectionLabel}"/>
                    <ComboBox Grid.Row="5" x:Name="quality_combo" Style="{StaticResource RoundedComboBox}"
                              ItemContainerStyle="{StaticResource ComboItemTooltip}" Margin="0,0,0,16"/>

                    <TextBlock Grid.Row="6" Text="TITLE BLOCK (FOR THE COMPARISON SHEET)" Style="{StaticResource SectionLabel}"/>
                    <ComboBox Grid.Row="7" x:Name="titleblock_combo" Style="{StaticResource RoundedComboBox}"
                              ItemContainerStyle="{StaticResource ComboItemTooltip}" Margin="0,0,0,16"/>

                    <TextBlock Grid.Row="8" Text="RECENT PROMPTS" Style="{StaticResource SectionLabel}"/>
                    <ComboBox Grid.Row="9" x:Name="recent_combo" Style="{StaticResource RoundedComboBox}"
                              ItemContainerStyle="{StaticResource ComboItemTooltip}" Margin="0,0,0,8"
                              SelectionChanged="recent_combo_changed"/>

                    <TextBlock Grid.Row="10" Text="EXTRA DIRECTION (MATERIALS, MOOD, CONTEXT)" Style="{StaticResource SectionLabel}" Margin="0,0,0,2"/>
                    <TextBox Grid.Row="11" x:Name="extra_box" Style="{StaticResource RoundedTextBox}"
                             Height="210" AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" Margin="0,0,0,4"/>

                    <CheckBox Grid.Row="12" x:Name="sheet_check"
                               Content="Build a before/after comparison sheet"
                               IsChecked="True" Margin="0,0,0,8" FontSize="13"/>

                    <StackPanel Grid.Row="13" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="cancel_btn" Content="Cancel" Width="92" Height="32"
                                Margin="0,0,8,0" Click="cancel_click"
                                Background="#FFEDEDF1" Foreground="#FF444450"/>
                        <Button x:Name="render_btn" Content="Render" Width="92" Height="32"
                                Click="render_click" Background="#FF2F6FED" Foreground="White"/>
                    </StackPanel>
                </Grid>

                <!-- ===================== PROGRESS PANEL ===================== -->
                <Grid x:Name="progress_panel" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" VerticalAlignment="Center">
                        <TextBlock Text="AI Render" FontSize="21" FontWeight="Bold" Foreground="#FF222228"
                                   HorizontalAlignment="Center" Margin="0,0,0,24"/>
                        <TextBlock x:Name="progress_status_text" Text="Working..." FontSize="13.5"
                                   Foreground="#FF44444E" TextWrapping="Wrap" TextAlignment="Center"
                                   Margin="0,0,0,18"/>
                        <ProgressBar IsIndeterminate="True" Height="6" Margin="0,0,0,26"/>
                        <Button x:Name="progress_cancel_btn" Content="Close" Width="90" Height="32"
                                HorizontalAlignment="Center" Click="cancel_click"
                                Background="#FFEDEDF1" Foreground="#FF444450"/>
                    </StackPanel>

                    <Image x:Name="logo_image" Grid.Row="1" Height="170" Stretch="Uniform"
                           HorizontalAlignment="Center" VerticalAlignment="Bottom"
                           Margin="0,0,0,16" Opacity="0.85"/>
                </Grid>

                <!-- ===================== REVIEW PANEL ===================== -->
                <Grid x:Name="review_panel" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="AI Render — Review" FontSize="21" FontWeight="Bold" Foreground="#FF222228"
                               Margin="0,0,0,10"/>

                    <Border Grid.Row="1" Background="Black" CornerRadius="6" ClipToBounds="True">
                        <Image x:Name="result_image_view" Stretch="Uniform"/>
                    </Border>

                    <TextBlock Grid.Row="2" x:Name="review_status_text" Text=""
                               Foreground="#FF8A8A94" FontSize="11" TextWrapping="Wrap"
                               Margin="0,8,0,6"/>

                    <StackPanel Grid.Row="3" Margin="0,0,0,6">
                        <TextBlock Text="EDIT WITH AI" FontSize="11" FontWeight="SemiBold"
                                   Foreground="#FF8A8A94" Margin="0,0,0,4"/>
                        <!-- Logo attachment row -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Button x:Name="attach_logo_btn" Content="Attach Logo / Image" Width="150" Height="28"
                                    Click="attach_logo_click"
                                    Background="#FFEDEDF1" Foreground="#FF444450"/>
                            <TextBlock x:Name="attached_logo_text" Text="No file attached"
                                       FontSize="11" Foreground="#FFB0B0B8"
                                       VerticalAlignment="Center" Margin="10,0,0,0"
                                       TextTrimming="CharacterEllipsis" MaxWidth="260"/>
                            <Button x:Name="clear_logo_btn" Content="x" Width="22" Height="22"
                                    Visibility="Collapsed" Margin="6,0,0,0"
                                    Click="clear_logo_click"
                                    Background="#FFEDEDF1" Foreground="#FF888894"/>
                        </StackPanel>
                        <TextBlock Text="RECENT EDIT INSTRUCTIONS" FontSize="11" FontWeight="SemiBold"
                                   Foreground="#FF8A8A94" Margin="0,0,0,4"/>
                        <ComboBox x:Name="recent_edit_combo" Height="32" Padding="8,0"
                                  BorderBrush="#FFDCDCE3" Background="White" FontSize="12.5"
                                  Margin="0,0,0,6" SelectionChanged="recent_edit_combo_changed"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" x:Name="edit_instruction_box"
                                     Height="105" Padding="8,6" BorderBrush="#FFDCDCE3"
                                     BorderThickness="1" Background="White" FontSize="13"
                                     AcceptsReturn="True" TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     Margin="0,0,6,0"/>
                            <Button Grid.Column="1" x:Name="edit_btn" Content="Apply Edit" Width="100" Height="105"
                                    Click="edit_click" Background="#FF2F6FED" Foreground="White"/>
                        </Grid>
                    </StackPanel>

                    <TextBlock Grid.Row="4" x:Name="edit_progress_bar_spacer"
                               Text="Attach a logo or reference image above, edit the instruction, then click Apply Edit."
                               FontSize="11" Foreground="#FFB0B0B8" TextWrapping="Wrap"
                               Margin="0,4,0,4"/>

                    <ProgressBar Grid.Row="5" x:Name="edit_progress_bar"
                                 IsIndeterminate="True" Height="4"
                                 Visibility="Collapsed" Margin="0,4,0,4"/>

                    <TextBlock Grid.Row="6" x:Name="edit_status_text" Text=""
                               Foreground="#FF8A8A94" FontSize="11" TextWrapping="Wrap"
                               Margin="0,0,0,8"/>

                    <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="open_folder_btn" Content="Open Folder" Width="100" Height="32"
                                Margin="0,0,6,0" Click="open_folder_click"
                                Background="#FFEDEDF1" Foreground="#FF444450"/>
                        <Button x:Name="rerender_btn" Content="Re-render" Width="92" Height="32"
                                Margin="0,0,6,0" Click="rerender_click"
                                Background="#FFEDEDF1" Foreground="#FF444450"/>
                        <Button x:Name="accept_btn" Content="Accept &amp; Place" Width="110" Height="32"
                                Click="accept_click" Background="#FF27AE60" Foreground="White"/>
                    </StackPanel>
                </Grid>

                <!-- ===================== PLACED PANEL ===================== -->
                <Grid x:Name="placed_panel" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="AI Render" FontSize="21" FontWeight="Bold" Foreground="#FF222228"
                                   HorizontalAlignment="Center" Margin="0,0,0,16"/>
                        <TextBlock x:Name="placed_status_text" Text="" FontSize="13.5"
                                   Foreground="#FF44444E" TextWrapping="Wrap" TextAlignment="Center"
                                   Margin="0,0,0,24"/>
                        <Image x:Name="placed_logo_image" Height="130" Stretch="Uniform"
                               HorizontalAlignment="Center" Opacity="0.85"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,8">
                        <Button x:Name="placed_new_btn" Content="New Render" Width="110" Height="32"
                                Margin="0,0,6,0" Click="new_render_click"
                                Background="#FFEDEDF1" Foreground="#FF444450"/>
                        <Button x:Name="placed_close_btn" Content="Close" Width="90" Height="32"
                                Click="close_click" Background="#FF2F6FED" Foreground="White"/>
                    </StackPanel>
                </Grid>

            </Grid>
        </Border>
    </Grid>
</Window>
