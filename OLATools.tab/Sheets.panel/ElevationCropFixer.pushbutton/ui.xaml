<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Elevation Crop Fixer"
    Height="950" Width="780"
    MinHeight="640" MinWidth="700"
    WindowStartupLocation="CenterScreen"
    ResizeMode="CanResizeWithGrip"
    Background="#FF2B2B2B">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="4"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Margin" Value="2"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Margin" Value="2"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="3"/>
        </Style>
        <Style x:Key="FieldHeadingStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFFFB74D"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="2,0,2,0"/>
        </Style>
        <Style x:Key="RoomListItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#FF3A3A3A"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Style.Triggers>
                <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                    <Setter Property="Background" Value="#FF262626"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- LEFT: room picker -->
        <StackPanel Grid.Column="0" Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
            <TextBlock Text="Rooms from:" VerticalAlignment="Center"/>
            <ComboBox x:Name="cbScope" Width="160" Margin="6,0,12,0" SelectedIndex="0">
                <ComboBoxItem Content="Active view"/>
                <ComboBoxItem Content="Active level"/>
                <ComboBoxItem Content="Entire model"/>
            </ComboBox>
            <TextBox x:Name="tbSearch" Width="180"/>
            <TextBlock Text="  (filter)" VerticalAlignment="Center" Foreground="Gray"/>
        </StackPanel>

        <Border Grid.Column="0" Grid.Row="1" BorderBrush="Gray" BorderThickness="1">
            <ListBox x:Name="lstRooms" Background="#FF1E1E1E" Foreground="White"
                     BorderThickness="0" AlternationCount="2"
                     ItemContainerStyle="{StaticResource RoomListItemStyle}"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"/>
        </Border>

        <StackPanel Grid.Column="0" Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
            <Button x:Name="btnAll" Content="Select All"/>
            <Button x:Name="btnNone" Content="Select None"/>
            <TextBlock x:Name="lblCount" VerticalAlignment="Center" Foreground="Gray" Margin="10,0,0,0"/>
            <TextBlock x:Name="lblSelectedCount" VerticalAlignment="Center" Foreground="#FFFFB74D" FontWeight="Bold" Margin="10,0,0,0"/>
        </StackPanel>

        <!-- RIGHT: options -->
        <ScrollViewer Grid.Column="2" Grid.Row="0" Grid.RowSpan="2" VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="Wall crop offset (mm)" Style="{StaticResource FieldHeadingStyle}"/>
            <TextBlock Text="Beyond each side wall's far face" Foreground="Gray" FontSize="11"/>
            <TextBox x:Name="txtWallOffset" Text="75" Margin="2,2,2,10"/>

            <TextBlock Text="Ceiling crop offset (mm)" Style="{StaticResource FieldHeadingStyle}"/>
            <TextBlock Text="Above the topmost ceiling face" Foreground="Gray" FontSize="11"/>
            <TextBox x:Name="txtCeilingOffset" Text="100" Margin="2,2,2,10"/>

            <TextBlock Text="Floor crop offset (mm)" Style="{StaticResource FieldHeadingStyle}"/>
            <TextBlock Text="Below this room's own floor (recomputed each run - fixes a bottom edge inherited from a copy/pasted marker)" Foreground="Gray" FontSize="11" TextWrapping="Wrap"/>
            <TextBox x:Name="txtFloorOffset" Text="0" Margin="2,2,2,10"/>

            <TextBlock Text="Level / grid end extension (mm)" Style="{StaticResource FieldHeadingStyle}"/>
            <TextBlock Text="Levels: right end past crop. Grids: bottom end only (see grid bubble offset below for the top end)." Foreground="Gray" FontSize="11" TextWrapping="Wrap"/>
            <TextBox x:Name="txtDatumExt" Text="100" Margin="2,2,2,10"/>

            <TextBlock Text="Level left offset (mm)" Style="{StaticResource FieldHeadingStyle}"/>
            <TextBlock Text="Left end of level line, past the crop's left edge (independent of the right-end extension above)" Foreground="Gray" FontSize="11" TextWrapping="Wrap"/>
            <TextBox x:Name="txtLevelLeftOffset" Text="600" Margin="2,2,2,10"/>

            <TextBlock Text="Grid bubble offset below ceiling (mm)" Style="{StaticResource FieldHeadingStyle}"/>
            <TextBlock Text="Grid's top end (with bubble) sits this far below the ceiling line, instead of extending past the crop like the bottom end" Foreground="Gray" FontSize="11" TextWrapping="Wrap"/>
            <TextBox x:Name="txtGridBubbleOffset" Text="25" Margin="2,2,2,10"/>

            <CheckBox x:Name="chkSkipModified" Content="Skip elevations with an already-modified crop" IsChecked="True" Margin="2,10,2,2"/>
            <CheckBox x:Name="chkHideLevelBubble" Content="Hide right-hand level bubble" IsChecked="True" Margin="2,2,2,2"/>
            <CheckBox x:Name="chkExtendGrids" Content="Extend grid ends past crop" IsChecked="True" Margin="2,2,2,2"/>
            <CheckBox x:Name="chkFarClip" Content="Set far clip offset" IsChecked="True" Margin="2,10,2,2"/>
            <TextBlock Text="Far clip offset (mm)" Foreground="Gray" FontSize="11"/>
            <TextBox x:Name="txtFarClipOffset" Text="5000" Margin="2,2,2,10"/>

            <Separator Margin="2,14,2,10"/>
            <TextBlock Text="ELEVATION VIEW TEMPLATE" FontWeight="Bold" Foreground="#FF4FC3F7"/>
            <TextBox x:Name="tbTemplateFilter" Margin="2,4,2,4"/>
            <TextBlock Text="(type to filter, then pick below)" Foreground="Gray" FontSize="11" Margin="2,0,2,4"/>
            <ComboBox x:Name="cbElevTemplate" Margin="2,0,2,4"/>
            <CheckBox x:Name="chkOverrideTemplate" Content="Override views that already have a template" Margin="2,2,2,2"/>

            <Separator Margin="2,14,2,10"/>
            <TextBlock Text="ROOM TAG TYPE" FontWeight="Bold" Foreground="#FF4FC3F7"/>
            <TextBox x:Name="tbRoomTagFilter" Margin="2,4,2,4"/>
            <TextBlock Text="(type to filter, then pick below)" Foreground="Gray" FontSize="11" Margin="2,0,2,4"/>
            <ComboBox x:Name="cbRoomTagType" Margin="2,0,2,4"/>
            <TextBlock Text="Centred left-right on crop, 1/4 down from ceiling" Foreground="Gray" FontSize="11" TextWrapping="Wrap" Margin="2,0,2,2"/>

            <Separator Margin="2,14,2,10"/>
            <Button x:Name="btnRun" Content="Run" Background="#FF3E8E41" Foreground="White" FontWeight="Bold"/>
            <Button x:Name="btnClose" Content="Close"/>
        </StackPanel>
        </ScrollViewer>

        <ProgressBar x:Name="pb" Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="2"
                     Height="6" Margin="0,40,0,0" Minimum="0" Maximum="100"/>
    </Grid>
</Window>
